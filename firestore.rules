rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pacts/{pactId} {
      allow read, write: if request.auth != null;

      match /cycles/{cycleId} {
        allow read, write: if request.auth != null;
      }
      match /workoutLogs/{logId} {
        allow read, write: if request.auth != null;
      }
      match /notifPrefs/{uid} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
